WAVES_DATA_DIR=
WAVES_TOKEN=
WAVES_USER_ID=
WAVES_SERVER_ID=
WAVES_ROLE_ID=
WAVES_DID=
WAVES_ACCOUNT_ID=env
WAVES_API_BASE_URL=https://api.kurobbs.com
WAVES_PROXY_URL=
WAVES_HTTP_TIMEOUT=30000
WAVES_MAX_CONCURRENCY=3
WAVES_LOG_LEVEL=info
